!skills/vercel-react-best-practices/**
!skills-lock.json

# Never track runtime state, credentials, or operating-system metadata.
**/.DS_Store
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/*.lock
**/auth.json
**/secrets.yml
**/secret-placeholder.key
**/sessions/
**/cache/
**/logs/
